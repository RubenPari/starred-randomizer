{
  "name": "backend",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "migrate:auth": "node dist/migrate-auth.js",
    "test": "npm run build && node --test test/*.test.cjs test/*.test.mjs"
  },
  "keywords": [
    "github",
    "starred",
    "randomizer"
  ],
  "author": "",
  "license": "ISC",
  "description": "Fastify backend for GitHub Starred Randomizer",
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/static": "^8.1.1",
    "argon2": "^0.44.0",
    "better-auth": "1.7.25",
    "dotenv": "^17.2.1",
    "fastify": "^5.4.0",
    "fastify-plugin": "^5.0.1",
    "kysely": "^0.29.9",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@electric-sql/pglite-socket": "^0.2.19",
    "@types/node": "^24.2.1",
    "@types/pg": "^8.21.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2"
  }
}
