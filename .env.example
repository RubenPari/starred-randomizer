GITHUB_TOKEN=your_github_personal_access_token
PORT=3001

# PostgreSQL configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=starred_randomizer
DB_POOL_MAX=10
# Set to "true" for TLS (e.g. managed Postgres over a public endpoint; not needed with the Cloud SQL socket)
DB_SSL=false

# Better Auth (generate a high-entropy secret of at least 32 characters)
# Required in production; a development-only fallback is available locally.
BETTER_AUTH_SECRET=
# Public backend origin; in production use the HTTPS URL serving the app.
BETTER_AUTH_URL=http://localhost:3001

# Optional
CORS_ORIGIN=http://localhost:5173
HOST=0.0.0.0
# 0 ignores forwarded IPs. Behind a proxy, set the verified fixed hop count.
# Only enable when clients cannot bypass those proxies.
TRUST_PROXY_HOPS=0
